{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rob-run-site",
	"compatibility_date": "2026-11-20",
	// Static site: Next.js exports every page to ./out at build time.
	// There is no Worker code, so requests never hit CPU limits.
	"assets": {
		"directory": "./out",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Workers Logs / metrics in the dashboard. Kept here so a deploy does not reset it.
	"observability": {
		"enabled": true
	},
	// Subdomain on the funchosa.com zone. The zone must be in the same Cloudflare account.
	// custom_domain creates the DNS record and the certificate on deploy.
	"routes": [
		{
			"pattern": "fencebook.funchosa.com",
			"custom_domain": true,
			"zone_name": "funchosa.com"
		}
	]
}

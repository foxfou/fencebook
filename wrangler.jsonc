{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "rob-run-site",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Subdomain on the funchosa.com zone. The zone must be in the same Cloudflare account.
	// custom_domain creates the DNS record and the certificate on deploy.
	"routes": [
		{
			"pattern": "fencebook.funchosa.com",
			"custom_domain": true,
			"zone_name": "funchosa.com"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "rob-run-site"
		}
	]
}